---
import Base from '../layouts/Base.astro';
import Mini from '../components/Mini.astro';
import { t, eras, localePath, type Lang } from '../i18n/strings';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const h = s.home;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': Astro.site!.origin + '/#org',
      name: 'fakelockscreen.app',
      url: Astro.site!.origin,
      logo: Astro.site!.origin + '/favicon.svg',
      founder: { '@id': Astro.site!.origin + '/#author' },
      sameAs: ['https://github.com/FlorianSLZ/FakeLockscreen.app', 'https://scloud.work'],
    },
    {
      '@type': 'Person',
      '@id': Astro.site!.origin + '/#author',
      name: 'Florian Salzmann',
      url: 'https://scloud.work/en/about-florian/',
      worksFor: { '@type': 'Organization', name: 'scloud', url: 'https://scloud.work' },
      sameAs: ['https://www.linkedin.com/in/fsalzmann/', 'https://scloud.work', 'https://github.com/FlorianSLZ'],
    },
    {
      '@type': 'FAQPage',
      '@id': Astro.site!.origin + localePath('/', lang) + '#faq',
      inLanguage: lang,
      mainEntity: h.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    {
      '@type': 'WebSite',
      '@id': Astro.site!.origin + '/#website',
      author: { '@id': Astro.site!.origin + '/#author' },
      publisher: { '@id': Astro.site!.origin + '/#org' },
      name: 'fakelockscreen.app',
      url: Astro.site!.origin,
      inLanguage: ['en', 'de'],
      description: h.description,
    },
    {
      '@type': 'WebApplication',
      '@id': Astro.site!.origin + '/#app',
      isPartOf: { '@id': Astro.site!.origin + '/#website' },
      publisher: { '@id': Astro.site!.origin + '/#org' },
      name: 'Fake Lock Screen',
      applicationCategory: 'EntertainmentApplication',
      operatingSystem: 'Any (modern web browser)',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' },
      description: h.description,
    },
  ],
};
---
<Base lang={lang} title={h.title} description={h.description} path="/" ogSlug="home">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <nav class="rail" aria-label={h.timeline}>
    {eras.map((e) => (
      <a href={`#${e.id}`} data-rail={e.id}><span>{e.name}</span>{e.year}</a>
    ))}
  </nav>

  <main id="main">
    <section class="hero" id="top" data-era-section="hero">
      <div class="hero-inner">
        <p class="lock-date" aria-hidden="true" data-clock="date">Monday</p>
        <strong class="lock-time" aria-hidden="true" data-clock="time">12:00</strong>
        <h1>{h.h1a} <span>{h.h1b}</span></h1>
        <p class="lead">{h.lead}</p>
        <div class="hero-cta">
          <a class="btn" href="#xp">{h.start}</a>
          <a class="btn ghost" href={localePath('/awareness', lang)}>{h.forIt}</a>
        </div>
      </div>
      <ul class="floaters">
        {eras.map((e, i) => (
          <li class="floater" data-depth={[18, 26, 14, 22, 30, 16, 24, 20][i]} style={`--i:${i};--d:${[6.5, 7.5, 6, 8, 7, 6.8, 7.2, 7.8][i]}s;--r:${[-6, 4, 5, -4, 3, -3, 6, -5][i]}deg;${['--x:2%;--y:12%', '--x:13%;--yb:4%', '--x:1%;--y:46%', '--xr:3%;--y:8%', '--xr:15%;--yb:3%', '--xr:6%;--y:44%', '--x:21%;--y:2%', '--xr:27%;--y:1%'][i]}`}>
            <a href={localePath(`/${e.id}`, lang)} aria-label={`${h.launch} ${e.name}`}>
              <span class="shot"><Mini os={e.id} user={h.user} /></span>
              <span class="tag"><span>{e.name}</span><em>{e.year}</em><b aria-hidden="true">→</b></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="scroll-cue">{h.scroll}</div>
    </section>

    {eras.map((e, i) => (
      <section class={`era${i % 2 ? ' flip' : ''}`} id={e.id} data-era-section={e.id} aria-labelledby={`${e.id}-h`}>
        <div class="ghost-year" aria-hidden="true">{e.year}</div>
        <div class="era-text">
          <p class="era-year">{e.year}</p>
          <h2 id={`${e.id}-h`}>{e.name}</h2>
          <p class="era-tag">{h.tagline[e.id]}</p>
          <p class="fact">
            <strong>{h.funFact}</strong>{h.fact[e.id]}
            <span class="fact-src">
              {h.factSrc[e.id].map((x) => <a href={x.url} target="_blank" rel="noopener">{x.label}<span aria-hidden="true"> ↗</span></a>)}
            </span>
          </p>
          {e.ready ? (
            <a class="btn" href={localePath(`/${e.id}`, lang)}>{h.launch} {e.name} →</a>
          ) : (
            <a class="btn" aria-disabled="true" role="link" tabindex="-1">{h.soon}</a>
          )}
        </div>
        <div class="era-preview monitor-wrap" role="img" aria-label={`${h.previewLabel}: ${e.name}`}>
          <div class="monitor"><div class="monitor-screen"><Mini os={e.id} user={h.user} /></div></div>
        </div>
      </section>
    ))}

    <section class="teaser" data-era-section="awareness">
      <div class="teaser-inner">
        <h2>{h.awareness.h2}</h2>
        <p>{h.awareness.p}</p>
        <a class="btn" href={localePath('/awareness', lang)}>{h.awareness.cta}</a>
      </div>
    </section>

    <section class="faq" id="faq" aria-labelledby="faq-h">
      <div class="faq-inner">
        <h2 id="faq-h">{h.faq.h2}</h2>
        {h.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
        <p class="faq-more"><a href={localePath('/safety', lang)}>{h.faq.more} →</a></p>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  .fact-src { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 8px; font-size: .78rem; }
  .fact-src a { color: var(--muted); text-underline-offset: 3px; }
  .fact-src a:hover { color: var(--fg); }
  .faq { padding: 100px max(16px, 5vw) 70px; scroll-snap-align: start; }
  .faq-inner { max-width: 760px; margin: 0 auto; }
  .faq h2 { margin: 0 0 22px; font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.12; letter-spacing: -.02em; }
  .faq details { border: 1px solid var(--line); border-radius: 14px; padding: 14px 18px; margin-bottom: 10px; background: var(--card); }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq details p { color: var(--muted); margin: 10px 0 0; }
  .faq-more { margin: 18px 0 0; }
  .faq-more a { color: var(--era-accent); }
</style>

<script>
  // Era tint + rail: which section is on screen decides the colour of the whole page.
  const sections = [...document.querySelectorAll<HTMLElement>('[data-era-section]')];
  const rail = [...document.querySelectorAll<HTMLAnchorElement>('[data-rail]')];
  const io = new IntersectionObserver(
    (entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        const id = (en.target as HTMLElement).dataset.eraSection!;
        if (id === 'hero') document.body.removeAttribute('data-era');
        else document.body.dataset.era = id;
        rail.forEach((a) => a.setAttribute('aria-current', String(a.dataset.rail === id)));
      }
    },
    { threshold: 0.55 },
  );
  sections.forEach((s) => io.observe(s));

  // Live clocks in the mini previews (locale-aware, no network).
  const lang = document.documentElement.lang === 'de' ? 'de-CH' : navigator.language;
  // Time follows the device's own format (12h/24h), not the page language.
  const tfBase = new Intl.DateTimeFormat(navigator.language || undefined, { hour: 'numeric', minute: '2-digit' });
  const tf = {
    format: (d: Date) => tfBase.formatToParts(d).filter((p) => p.type !== 'dayPeriod').map((p) => p.value).join('').trim(),
  };
  const df = new Intl.DateTimeFormat(lang, { weekday: 'long', day: 'numeric', month: 'long' });
  const tick = () => {
    const d = new Date();
    document.querySelectorAll('[data-clock="time"]').forEach((n) => (n.textContent = tf.format(d)));
    document.querySelectorAll('[data-clock="date"]').forEach((n) => (n.textContent = df.format(d)));
  };
  tick();
  setInterval(tick, 1000);

  // Hero: floating screens drift slightly against the pointer.
  const floaters = [...document.querySelectorAll<HTMLElement>('.floater')];
  const hero = document.getElementById('top');
  if (hero && floaters.length && matchMedia('(hover: hover) and (min-width: 961px) and (prefers-reduced-motion: no-preference)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width - 0.5;
      const ny = (e.clientY - r.top) / r.height - 0.5;
      for (const f of floaters) {
        const d = Number(f.dataset.depth);
        f.style.setProperty('--px', `${(-nx * d).toFixed(1)}px`);
        f.style.setProperty('--py', `${(-ny * d).toFixed(1)}px`);
      }
    });
    hero.addEventListener('pointerleave', () => floaters.forEach((f) => { f.style.setProperty('--px', '0px'); f.style.setProperty('--py', '0px'); }));
  }
</script>
