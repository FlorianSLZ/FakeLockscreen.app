---
import { avatars } from '../lockscreens/core/avatars';
import Lock from '../layouts/Lock.astro';
import '../lockscreens/winvista/winvista.css';
import { icons } from '../lockscreens/core/icons';
import { t, type Lang } from '../i18n/strings';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).lockUi.winvista;
const seo = t(lang).lockSeo.winvista;
---
<Lock lang={lang} title={seo.title} description={seo.description} path="/winvista">
  <div class="wv" id="wv" data-wp="0">
    <div class="wv-bg" aria-hidden="true"><i class="r1"></i><i class="r2"></i><i class="r3"></i></div>
    <main class="wv-center">
      <div class="wv-tile" id="wv-avatar" aria-hidden="true"><Fragment set:html={avatars.winvista} /></div>
      <div class="wv-name" id="wv-name">User</div>
      <div class="wv-login" id="wv-login">
        <div class="wv-pw" id="wv-pwbox">
          <span class="wv-ph" aria-hidden="true">{s.password}</span>
          <span class="wv-dots" id="wv-dots" aria-hidden="true"></span>
          <span class="wv-go" aria-hidden="true" set:html={icons.arrow}></span>
        </div>
        <button type="button" class="wv-switch" id="wv-switch">{s.switchUser}</button>
      </div>
      <div class="wv-msg" id="wv-msg" role="alert" hidden>
        <p>{s.wrong}</p>
        <button type="button" class="wv-btn" id="wv-ok">{s.ok}</button>
      </div>
    </main>
    <div class="wv-brand" aria-hidden="true">
      <svg class="wv-flag" viewBox="0 0 64 64" focusable="false">
        <path d="M6 12 C16 6 24 18 31 12 L28 30 C21 36 13 24 3 30 Z" fill="#f25022" />
        <path d="M35 11 C42 16 50 6 60 11 L56 29 C48 34 41 26 32 30 Z" fill="#7fba00" />
        <path d="M3 34 C13 28 21 40 28 34 L25 52 C18 58 10 46 0 52 Z" fill="#00a4ef" />
        <path d="M32 34 C41 30 48 38 57 33 L53 51 C45 56 38 48 29 52 Z" fill="#ffb900" />
      </svg>
      <span class="wv-brand-text"><span class="wv-brand-win">Windows</span><span class="wv-brand-v">Vista</span></span>
    </div>
    <button type="button" class="wv-orb wv-ease" id="wv-ease" aria-label={s.ease} title={s.ease} set:html={icons.ease}></button>
    <button type="button" class="wv-orb wv-off" id="wv-off" aria-label={s.shutdown} title={s.shutdown} set:html={icons.power}></button>
  </div>
</Lock>

<script>
  import { createLock, createMessage, toast } from '../lockscreens/core/engine';
  import { t } from '../i18n/strings';
  import { applyAvatar } from '../lockscreens/core/avatars';
  import { defaults } from '../lib/config-codec';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const root = $('wv');
  const dots = $('wv-dots');
  const pwbox = $('wv-pwbox');
  const login = $('wv-login');
  const MAX = 22;

  const lock = createLock({
    onDots: (n) => {
      dots.textContent = '●'.repeat(Math.min(n, MAX));
      pwbox.classList.toggle('has-text', n > 0);
    },
    onWrong: () => {
      login.hidden = true;
      msg.show();
    },
    onStart: () => {
      $('wv-name').textContent = lock.cfg.name;
      applyAvatar($('wv-avatar'), lock.cfg.avatar, defaults.avatar);
      root.dataset.wp = String(lock.cfg.wallpaper);
      msg.reset();
      login.hidden = false;
      lock.setInputActive(true);
    },
    onStop: () => msg.reset(),
  });
  const msg = createMessage(lock, $('wv-msg'), $('wv-ok'), () => (login.hidden = false));

  const fake = () => toast(t(lock.cfg.lang).lock.fakeText);
  ['wv-ease', 'wv-switch'].forEach((id) => $(id).addEventListener('click', fake));
  $('wv-off').addEventListener('click', () => toast(t(lock.cfg.lang).lock.powerText));
</script>
