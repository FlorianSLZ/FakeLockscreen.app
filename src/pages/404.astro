---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found | fakelockscreen.app" description="This page does not exist." path="/" index={false}>
  <meta name="robots" content="noindex" slot="head" />
  <main id="main" class="bsod">
    <div class="bsod-inner">
      <p class="bsod-face" aria-hidden="true">:(</p>
      <h1>Your page ran into a problem and needs to be found again.</h1>
      <p class="bsod-progress"><span class="bsod-pct"></span> complete</p>
      <p class="bsod-sub">This is a harmless fake error. Nothing is wrong with your computer, the address you opened simply does not exist here.</p>
      <p class="bsod-sub" lang="de">Dies ist ein harmloser Fake-Fehler. Die aufgerufene Adresse gibt es hier nicht.</p>
      <div class="bsod-actions">
        <a class="bsod-btn" href="/">Restart: back to the timeline</a>
        <a class="bsod-btn ghost" href="/de">Deutsch</a>
      </div>
      <dl class="bsod-info">
        <dt>If you call a friend, give them this info:</dt>
        <dd>Stop code: PAGE_NOT_FOUND (404)</dd>
        <dd>What failed: this_url.sys</dd>
      </dl>
    </div>
  </main>
</Base>

<style is:global>
  @property --pct { syntax: '<integer>'; inherits: false; initial-value: 100; }
  body:has(.bsod) { background: #0b63c5; --era-bg: #0b63c5; --era-accent: #fff; color: #fff; min-height: 100vh; display: flex; flex-direction: column; }
  body:has(.bsod) .site-header, body:has(.bsod) .skip { display: none; }
  body:has(.bsod) .site-footer { background: transparent; border-top: 0; color: #cfe3fb; margin-top: auto; }
  .bsod { flex: 1; display: grid; align-items: center; padding: clamp(20px, 4vw, 48px) max(20px, 8vw); font-family: 'Segoe UI', system-ui, -apple-system, Roboto, 'Helvetica Neue', Arial, sans-serif; }
  .bsod-inner { max-width: 880px; }
  .bsod-face { font-size: clamp(4rem, 11vw, 7rem); line-height: 1; margin: 0 0 clamp(8px, 2vw, 24px); font-weight: 300; }
  .bsod h1 { font-size: clamp(1.3rem, 3.4vw, 2.1rem); font-weight: 400; line-height: 1.3; margin: 0 0 22px; max-width: 28ch; letter-spacing: 0; }
  .bsod-progress { font-size: clamp(1rem, 2.2vw, 1.35rem); margin: 0 0 22px; }
  .bsod-pct { --pct: 100; counter-reset: pct var(--pct); animation: bsod-count 9s cubic-bezier(.3,.1,.5,1) both; }
  .bsod-pct::before { content: counter(pct) '%'; }
  @keyframes bsod-count { from { --pct: 0; } to { --pct: 100; } }
  .bsod-sub { max-width: 62ch; margin: 0 0 12px; color: #e3effd; font-size: 1rem; line-height: 1.55; }
  .bsod-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 20px 0 22px; }
  .bsod-btn { display: inline-block; background: #fff; color: #0b63c5; font-weight: 600; padding: 12px 22px; border-radius: 4px; text-decoration: none; border: 2px solid #fff; }
  .bsod-btn.ghost { background: transparent; color: #fff; }
  .bsod-btn:hover { filter: brightness(.94); }
  .bsod-btn:focus-visible { outline: 3px solid #ffe14d; outline-offset: 3px; }
  .bsod-info { margin: 0; font-size: .9rem; color: #e3effd; }
  .bsod-info dt { margin-bottom: 4px; }
  .bsod-info dd { margin: 0; font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace; }
  .bsod-face { user-select: none; -webkit-tap-highlight-color: transparent; }
  /* Easter egg: triple-click the sad face for a slow fullscreen version. */
  @keyframes bsod-count-slow { from { --pct: 0; } to { --pct: 100; } }
  .bsod:fullscreen { background: #0b63c5; overflow: auto; cursor: none; }
  .bsod:fullscreen .bsod-pct { animation: bsod-count-slow 90s linear infinite; }
  .bsod:fullscreen .bsod-actions { display: none; }
  @media (prefers-reduced-motion: reduce) { .bsod-pct, .bsod:fullscreen .bsod-pct { animation: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.bsod');
  const face = document.querySelector<HTMLElement>('.bsod-face');
  if (root && face && root.requestFullscreen) {
    let clicks = 0;
    let timer: number | undefined;
    face.addEventListener('click', () => {
      clicks += 1;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { clicks = 0; }, 900);
      if (clicks >= 3) {
        clicks = 0;
        root.requestFullscreen().catch(() => {});
      }
    });
  }
</script>
