---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found | fakelockscreen.app" description="This page does not exist." path="/">
  <meta name="robots" content="noindex" slot="head" />
  <main id="main" class="page" style="text-align:center">
    <h1 style="font-size:clamp(2.4rem,7vw,4.5rem);margin:0 0 10px">404</h1>
    <p style="color:var(--muted);font-size:1.15rem">This page is locked away somewhere. Nothing here, sorry.</p>
    <p><a class="btn" href="/">Back to the timeline</a></p>
  </main>
</Base>
