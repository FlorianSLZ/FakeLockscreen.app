---
import '../styles/lock-base.css';
import { t, localePath, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // language-neutral path, e.g. /xp
  theme?: string; // gate accent
  wallpaper?: boolean; // offer "use my own wallpaper" (false for XP)
}
const { lang, title, description, path, wallpaper = true } = Astro.props;
const s = t(lang);
const site = Astro.site!.origin;
const other: Lang = lang === 'en' ? 'de' : 'en';
const name = title.split(':')[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebApplication', name, description, url: site + localePath(path, lang), inLanguage: lang, applicationCategory: 'EntertainmentApplication', operatingSystem: 'Any (modern web browser)', offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'fakelockscreen.app', item: site + localePath('/', lang) },
      { '@type': 'ListItem', position: 2, name, item: site + localePath(path, lang) },
    ] },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="color-scheme" content="dark" />
    <!-- Belt and braces: the browser itself refuses any network call or form post from this page. -->
    <meta http-equiv="Content-Security-Policy" content="connect-src 'none'; form-action 'none'; object-src 'none'; base-uri 'none'" />
    <link rel="canonical" href={site + localePath(path, lang)} />
    <link rel="alternate" hreflang="en" href={site + localePath(path, 'en')} />
    <link rel="alternate" hreflang="de" href={site + localePath(path, 'de')} />
    <link rel="alternate" hreflang="x-default" href={site + localePath(path, 'en')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site + localePath(path, lang)} />
    <meta property="og:image" content={`${site}/og${path}.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {path === '/win11' && <link rel="preload" as="image" href="/wallpapers/w11-bg.webp" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <main id="gate" class="gate">
      <div class="gate-card">
        <p class="gate-eyebrow">fakelockscreen.app</p>
        <h1>{s.lock.gateTitle}</h1>
        <p class="gate-text">{s.lock.gateText}</p>
        <ul class="gate-safe">
          <li>{s.lock.safe1}</li>
          <li>{s.lock.safe2}</li>
          <li>{s.lock.safe3}</li>
        </ul>
        <button id="start" class="gate-start" type="button">{s.lock.start}</button>
        {wallpaper && (
          <div class="gate-wp">
            <button id="wp-btn" class="gate-link" type="button">{s.lock.wpButton}</button>
            <button id="wp-clear" class="gate-link" type="button" hidden>{s.lock.wpClear}</button>
            <p id="wp-status" class="gate-wp-status" role="status"></p>
            <p class="gate-wp-note">{s.lock.wpNote}</p>
          </div>
        )}
        <p class="gate-mobile">{s.lock.mobile}</p>
        <a class="gate-back" href={localePath('/', lang) + '#' + path.slice(1)}>{s.lock.back}</a>
      </div>
      <footer class="gate-footer">
        <p>{s.footer}</p>
        <p><a href={localePath('/about', lang)}>{s.nav.about}</a> · <a href={localePath('/safety', lang)}>{s.nav.safety}</a> · <a href={localePath(path, other)} hreflang={other} lang={other}>{s.nav.switchTo}</a></p>
      </footer>
    </main>

    <div id="stage" class="stage" hidden>
      <slot />
    </div>
    <div id="esc-ring" class="esc-ring" aria-hidden="true">
      <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" /></svg>
      <span>{s.lock.escHint}</span>
    </div>
  </body>
</html>

<script>
  import { initWallpaper } from '../lockscreens/core/wallpaper';
  initWallpaper();
</script>
