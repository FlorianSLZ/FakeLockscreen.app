---
import '../styles/global.css';
import { t, localePath, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // language-neutral path
  ogSlug?: string;
  era?: string;
  index?: boolean; // false: no canonical/hreflang/breadcrumb (e.g. 404)
}
const { lang, title, description, path, ogSlug = 'home', era, index = true } = Astro.props;
const s = t(lang);
const site = Astro.site!.origin;
const other: Lang = lang === 'en' ? 'de' : 'en';
const url = site + localePath(path, lang);
const crumbName = title.split(/[:|]/)[0].trim();
const breadcrumb = path !== '/' ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'fakelockscreen.app', item: site + localePath('/', lang) },
    { '@type': 'ListItem', position: 2, name: crumbName, item: url },
  ],
} : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    {index && <link rel="canonical" href={url} />}
    {index && <link rel="alternate" hreflang="en" href={site + localePath(path, 'en')} />}
    {index && <link rel="alternate" hreflang="de" href={site + localePath(path, 'de')} />}
    {index && <link rel="alternate" hreflang="x-default" href={site + localePath(path, 'en')} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_US'} />
    <meta property="og:site_name" content="fakelockscreen.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${site}/og/${ogSlug}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={crumbName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {index && breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body data-era={era}>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="site-header">
      <a class="logo" href={localePath('/', lang)} aria-label="fakelockscreen.app">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3" fill="currentColor"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        <span>fakelockscreen<b>.app</b></span>
      </a>
      <nav aria-label="Main">
        <a href={localePath('/awareness', lang)}>{s.nav.awareness}</a>
        <a href={localePath('/about', lang)}>{s.nav.about}</a>
        <a href={localePath('/safety', lang)}>{s.nav.safety}</a>
        <a class="lang" href={localePath(path, other)} hreflang={other} lang={other} aria-label={s.nav.switchLabel}>{s.nav.switchTo}</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p class="legal">{s.footer}</p>
      <p class="byline">
        <span>{s.home.by.from} <a class="by-site" href="https://scloud.work" target="_blank" rel="noopener">{s.home.by.site}</a> {s.home.by.by} <a href="https://scloud.work/en/about-florian/" target="_blank" rel="noopener">{s.home.by.name}</a></span>
        <a class="by-li" href="https://www.linkedin.com/in/fsalzmann/" target="_blank" rel="noopener me" aria-label="Florian Salzmann, LinkedIn">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect width="24" height="24" rx="5" fill="currentColor"/><path fill="#0b0d14" d="M7.1 9.6h2.6V18H7.1zM8.4 5.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zM11.4 9.6h2.5v1.2c.4-.7 1.3-1.4 2.6-1.4 2.7 0 3.2 1.8 3.2 4.1V18h-2.6v-3.9c0-.9 0-2.1-1.3-2.1s-1.500 1-1.500 2V18h-2.600z"/></svg>
          {s.home.by.linkedin}
        </a>
      </p>
    </footer>
  </body>
</html>
