---
import '../styles/global.css';
import { t, localePath, type Lang } from '../i18n/strings';
import { repoUrl } from '../i18n/pages';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // language-neutral path
  ogSlug?: string;
  era?: string;
  index?: boolean; // false: no canonical/hreflang/breadcrumb (e.g. 404)
}
const { lang, title, description, path, ogSlug = 'home', era, index = true } = Astro.props;
const s = t(lang);
const site = Astro.site!.origin;
const other: Lang = lang === 'en' ? 'de' : 'en';
const url = site + localePath(path, lang);
const crumbName = title.split(/[:|]/)[0].trim();
const breadcrumb = path !== '/' ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'fakelockscreen.app', item: site + localePath('/', lang) },
    { '@type': 'ListItem', position: 2, name: crumbName, item: url },
  ],
} : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    {index && <link rel="canonical" href={url} />}
    {index && <link rel="alternate" hreflang="en" href={site + localePath(path, 'en')} />}
    {index && <link rel="alternate" hreflang="de" href={site + localePath(path, 'de')} />}
    {index && <link rel="alternate" hreflang="x-default" href={site + localePath(path, 'en')} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_US'} />
    <meta property="og:site_name" content="fakelockscreen.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${site}/og/${ogSlug}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={crumbName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {index && breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body data-era={era}>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="site-header">
      <a class="logo" href={localePath('/', lang)} aria-label="fakelockscreen.app">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3" fill="currentColor"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        <span>fakelockscreen<b>.app</b></span>
      </a>
      <nav aria-label="Main">
        <a href={localePath('/awareness', lang)}>{s.nav.awareness}</a>
        <a href={localePath('/about', lang)}>{s.nav.about}</a>
        <a href={localePath('/safety', lang)}>{s.nav.safety}</a>
        <a class="lang" href={localePath(path, other)} hreflang={other} lang={other} aria-label={s.nav.switchLabel}>{s.nav.switchTo}</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="foot-grid">
        <div class="foot-brand">
          <a class="logo" href={localePath('/', lang)} aria-label="fakelockscreen.app">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3" fill="currentColor"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
            <span>fakelockscreen<b>.app</b></span>
          </a>
          <p>{s.foot.tagline}</p>
        </div>
        <nav class="foot-col" aria-label={s.foot.screens}>
          <h2>{s.foot.screens}</h2>
          <ul>
            <li><a href={localePath('/xp', lang)}>Windows XP</a></li>
            <li><a href={localePath('/winvista', lang)}>Windows Vista</a></li>
            <li><a href={localePath('/win7', lang)}>Windows 7</a></li>
            <li><a href={localePath('/win8', lang)}>Windows 8</a></li>
            <li><a href={localePath('/win81', lang)}>Windows 8.1</a></li>
            <li><a href={localePath('/win10', lang)}>Windows 10</a></li>
            <li><a href={localePath('/win11', lang)}>Windows 11</a></li>
            <li><a href={localePath('/macos', lang)}>macOS</a></li>
          </ul>
        </nav>
        <nav class="foot-col" aria-label={s.foot.project}>
          <h2>{s.foot.project}</h2>
          <ul>
            <li><a href={localePath('/awareness', lang)}>{s.nav.awareness}</a></li>
            <li><a href={localePath('/about', lang)}>{s.nav.about}</a></li>
            <li><a href={localePath('/safety', lang)}>{s.nav.safety}</a></li>
            <li><a href={repoUrl} target="_blank" rel="noopener">{s.foot.source}</a></li>
            <li><a href="/.well-known/security.txt">{s.foot.security}</a></li>
          </ul>
        </nav>
      </div>
      <p class="legal">{s.footer}</p>
      <p class="byline">
        <span>{s.foot.made} <a class="by-name" href="https://www.linkedin.com/in/fsalzmann/" target="_blank" rel="noopener me" title={s.foot.nameTitle}>{s.home.by.name}</a></span>
        <span class="dot" aria-hidden="true">·</span>
        <span>{s.home.by.from} <a class="by-site" href="https://scloud.work" target="_blank" rel="noopener">{s.home.by.site}</a></span>
        <span class="dot" aria-hidden="true">·</span>
        <a class="by-gh" href={repoUrl} target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.08-2.7-1.08-.36-.93-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          <span>GitHub</span>
        </a>
      </p>
    </footer>
  </body>
</html>
