---
// Pure CSS/HTML miniature of each lock screen, sized with container query units.
// CSS/SVG miniatures; Win10/11/macOS use the local wallpaper files. Clock text is filled in by the page script (data-clock).
interface Props { os: 'xp' | 'winvista' | 'win7' | 'win8' | 'win81' | 'win10' | 'win11' | 'macos'; user: string }
const { os, user } = Astro.props;
---
<div class={`mini mini-${os}`}>
  {os === 'xp' && (
    <>
      <div class="x-top"></div>
      <div class="x-left"><div class="x-brand"><svg class="flag" viewBox="0 0 64 64" aria-hidden="true"><path d="M6 12 C16 6 24 18 31 12 L28 30 C21 36 13 24 3 30 Z" fill="#f25022"/><path d="M35 11 C42 16 50 6 60 11 L56 29 C48 34 41 26 32 30 Z" fill="#7fba00"/><path d="M3 34 C13 28 21 40 28 34 L25 52 C18 58 10 46 0 52 Z" fill="#00a4ef"/><path d="M32 34 C41 30 48 38 57 33 L53 51 C45 56 38 48 29 52 Z" fill="#ffb900"/></svg><span class="x-bt"><small>Microsoft<sup>®</sup></small><b>Windows<sup>xp</sup></b></span></div><p>To begin, click your user name</p></div>
      <div class="x-div"></div>
      <div class="x-user"><div class="x-tile">🙂</div><div class="x-name">{user}</div></div>
      <div class="x-bot"><span class="x-off">⏻</span><i></i></div>
    </>
  )}
  {os === 'win7' && (
    <>
      <div class="w7-glow"></div>
      <div class="w7-tile">🙂</div>
      <div class="w7-name">{user}</div>
      <div class="w7-pw"><span></span><em>➜</em></div>
      <div class="w7-b w7-l">◔</div><div class="w7-brand"><svg class="flag" viewBox="0 0 64 64" aria-hidden="true"><path d="M6 12 C16 6 24 18 31 12 L28 30 C21 36 13 24 3 30 Z" fill="#f25022"/><path d="M35 11 C42 16 50 6 60 11 L56 29 C48 34 41 26 32 30 Z" fill="#7fba00"/><path d="M3 34 C13 28 21 40 28 34 L25 52 C18 58 10 46 0 52 Z" fill="#00a4ef"/><path d="M32 34 C41 30 48 38 57 33 L53 51 C45 56 38 48 29 52 Z" fill="#ffb900"/></svg><span>Windows</span><b>7</b></div><div class="w7-b w7-r">⏻</div>
    </>
  )}
  {os === 'winvista' && (
    <>
      <div class="wv-glow"></div>
      <div class="wv-tile">🙂</div>
      <div class="wv-name">{user}</div>
      <div class="wv-pw"><span></span><em>➜</em></div>
      <div class="wv-b wv-l">◔</div><div class="wv-brand"><span>Windows</span><b>Vista</b></div><div class="wv-b wv-r">⏻</div>
    </>
  )}
  {(os === 'win8' || os === 'win81') && (
    <>
      <div class="mt-clock"><strong data-clock="time">12:00</strong><span data-clock="date">Monday</span></div>
    </>
  )}
  {os === 'win10' && (
    <>
      
      <div class="w10-clock"><strong data-clock="time">12:00</strong><span data-clock="date">Monday</span></div>
    </>
  )}
  {os === 'win11' && (
    <>
      <div class="w11-clock"><span data-clock="date">Monday</span><strong data-clock="time">12:00</strong></div>
      <div class="w11-dock"><i></i><i></i><i></i></div>
    </>
  )}
  {os === 'macos' && (
    <>
      <div class="m-clock"><span data-clock="date">Monday</span><strong data-clock="time">12:00</strong></div>
      <div class="m-user"><div class="m-av">🙂</div><div class="m-name">{user}</div><div class="m-pill"><span>Enter Password</span></div></div>
    </>
  )}
</div>

<style>
  .mini { container-type: inline-size; position: relative; aspect-ratio: 16 / 10; overflow: hidden; color: #fff; font-family: system-ui, 'Segoe UI', sans-serif; }
  .mini > * { position: absolute; }

  /* XP */
  .mini-xp { background: linear-gradient(180deg, #6b8ce6, #5a7edc 50%, #5276d8); font-family: 'Trebuchet MS', Tahoma, sans-serif; }
  .x-top { inset: 0 0 auto 0; height: 10cqw; background: #00309c; border-bottom: .5cqw solid #f99b3d; }
  .x-bot { inset: auto 0 0 0; height: 11cqw; background: #003399; border-top: .5cqw solid #f99b3d; display: flex; align-items: center; padding: 0 3cqw; }
  .x-off { display: grid; place-items: center; width: 4.4cqw; height: 4.4cqw; border-radius: .8cqw; background: #d8431f; border: .2cqw solid #fff; font-size: 2.4cqw; }
  .x-left { right: 54cqw; top: 22cqw; text-align: right; width: 42cqw; }
    .x-brand { display: flex; align-items: center; justify-content: flex-end; gap: 1.6cqw; line-height: 1; }
  .x-brand .flag { width: 8cqw; height: 8cqw; }
  .x-bt { display: grid; text-align: left; } .x-bt small { font-size: 2.6cqw; font-weight: 600; } .x-bt b { font-size: 6.4cqw; font-style: italic; letter-spacing: -.3cqw; } .x-bt sup { font-size: 2.6cqw; color: #f99b3d; font-style: normal; }
  .x-left p { margin: 2cqw 0 0; font-size: 2.4cqw; font-style: italic; }
  .x-div { left: 50cqw; top: 16cqw; width: .25cqw; height: 40cqw; background: linear-gradient(transparent, #fff, transparent); }
  .x-user { left: 54cqw; top: 26cqw; display: flex; align-items: center; gap: 2.4cqw; }
  .x-tile { display: grid; place-items: center; width: 11cqw; height: 11cqw; font-size: 6cqw; border-radius: 1cqw; border: .4cqw solid #e8eefc; background: linear-gradient(145deg, #fdf4d3, #f2b84c 60%, #e48a1f); }
  .x-name { font-size: 3.6cqw; font-weight: 600; }

  /* Win 7 */
  .mini-win7 { background: linear-gradient(160deg, #0b3d6e, #1b7fa8 55%, #0a4f7a); }
  .w7-glow { inset: 0; background: radial-gradient(60cqw 40cqw at 15% 105%, rgba(43,217,192,.75), transparent), radial-gradient(55cqw 38cqw at 85% 100%, rgba(80,150,255,.65), transparent), radial-gradient(40cqw 25cqw at 50% 0%, rgba(180,255,230,.3), transparent); animation: aurora 9s ease-in-out infinite alternate; }
  @keyframes aurora { to { transform: translateX(3cqw) scale(1.08); } }
  .w7-tile { left: 50%; top: 18cqw; transform: translateX(-50%); display: grid; place-items: center; width: 17cqw; height: 17cqw; font-size: 9cqw; border-radius: 1.6cqw; background: linear-gradient(145deg, #e8f4ff, #7fb8e8); border: .7cqw solid rgba(255,255,255,.65); box-shadow: 0 0 0 .3cqw rgba(0,40,80,.5), 0 2cqw 4cqw rgba(0,0,0,.4); }
  .w7-name { left: 0; right: 0; top: 38cqw; text-align: center; font-size: 3.4cqw; text-shadow: 0 .2cqw 1cqw #000; }
  .w7-pw { left: 50%; top: 45cqw; transform: translateX(-50%); display: flex; width: 26cqw; height: 4.2cqw; border-radius: .6cqw; overflow: hidden; border: .2cqw solid rgba(255,255,255,.7); }
  .w7-pw span { flex: 1; background: #fff; } .w7-pw em { display: grid; place-items: center; width: 4.6cqw; font-style: normal; font-size: 2.4cqw; background: linear-gradient(#4fb7ea, #1c7bc0); }
  .w7-b { bottom: 3cqw; display: grid; place-items: center; width: 4.6cqw; height: 4.6cqw; border-radius: .8cqw; font-size: 2.6cqw; background: linear-gradient(#5fa4d8, #1e5f9b); border: .2cqw solid rgba(255,255,255,.7); }
  .w7-brand { left: 10.5cqw; bottom: 3cqw; height: 4.6cqw; display: flex; align-items: center; gap: 1cqw; font-size: 3.4cqw; line-height: 1; } .w7-brand .flag { width: 4.4cqw; height: 4.4cqw; } .w7-brand span { font-weight: 300; } .w7-brand b { font-size: 4.2cqw; font-weight: 600; }
  .w7-l { left: 3cqw; } .w7-r { right: 3cqw; background: linear-gradient(#e8785a, #b52c10); }

  /* Vista */
  .mini-winvista { background: linear-gradient(170deg, #021a14, #0b5a48 60%, #021a14); }
  .wv-glow { inset: 0; background: radial-gradient(60cqw 38cqw at 12% 105%, rgba(70,230,160,.7), transparent), radial-gradient(55cqw 36cqw at 88% 100%, rgba(40,170,200,.55), transparent), radial-gradient(40cqw 25cqw at 50% 0%, rgba(200,255,230,.25), transparent); }
  .wv-tile { left: 50%; top: 18cqw; transform: translateX(-50%); display: grid; place-items: center; width: 17cqw; height: 17cqw; font-size: 9cqw; border-radius: 1.6cqw; background: linear-gradient(145deg, #e6fff6, #7fd8c0); border: .7cqw solid rgba(255,255,255,.6); box-shadow: 0 0 0 .3cqw rgba(0,40,30,.6), 0 2cqw 4cqw rgba(0,0,0,.45); }
  .wv-name { left: 0; right: 0; top: 38cqw; text-align: center; font-size: 3.4cqw; text-shadow: 0 .2cqw 1cqw #000; }
  .wv-pw { left: 50%; top: 45cqw; transform: translateX(-50%); display: flex; width: 26cqw; height: 4.2cqw; border-radius: .6cqw; overflow: hidden; border: .2cqw solid rgba(255,255,255,.7); }
  .wv-pw span { flex: 1; background: #fff; } .wv-pw em { display: grid; place-items: center; width: 4.6cqw; font-style: normal; font-size: 2.4cqw; background: linear-gradient(#7fe08c, #238a36); }
  .wv-b { bottom: 3cqw; display: grid; place-items: center; width: 4.6cqw; height: 4.6cqw; border-radius: 50%; font-size: 2.6cqw; background: linear-gradient(#2c7d6a, #0b3a30); border: .3cqw solid rgba(255,255,255,.8); }
  .wv-l { left: 3cqw; } .wv-r { right: 3cqw; background: linear-gradient(#e0523a, #8c1a0a); }
  .wv-brand { right: 10cqw; bottom: 3cqw; height: 4.6cqw; display: flex; align-items: center; gap: 1cqw; font-size: 3.4cqw; line-height: 1; } .wv-brand span { font-weight: 300; } .wv-brand b { font-size: 4.2cqw; font-weight: 600; }

  /* Win 8 and 8.1 */
  .mini-win8 { background: radial-gradient(ellipse at 15% 108%, #5fd0ff, transparent 58%), linear-gradient(160deg, #071f55, #1d6fd1 60%, #071f55); }
  .mini-win81 { background: radial-gradient(ellipse at 20% 120%, rgba(95,208,255,.6), transparent 60%), linear-gradient(170deg, #16405f, #2b7fa8); }
  .mt-clock { left: 5cqw; bottom: 6cqw; display: grid; line-height: 1; text-shadow: 0 .2cqw 1.4cqw rgba(0,0,0,.4); }
  .mt-clock strong { font-size: 14cqw; font-weight: 200; letter-spacing: -.4cqw; }
  .mt-clock span { margin-top: 1cqw; font-size: 3.6cqw; font-weight: 300; }

  /* Win 10 */
  .mini-win10 { background: #15233d url('/wallpapers/w10-bg.webp') center / cover; }
  .w10-clock { left: 5cqw; bottom: 5cqw; display: grid; line-height: 1; text-shadow: 0 .2cqw 1.4cqw rgba(0,0,0,.45); }
  .w10-clock strong { font-size: 13cqw; font-weight: 300; letter-spacing: -.4cqw; }
  .w10-clock span { margin-top: 1cqw; font-size: 3.6cqw; }

  /* Win 11 */
  .mini-win11 { background: #0b0f2e url('/wallpapers/w11-bg.webp') center / cover; }
  .w11-clock { left: 0; right: 0; top: 8cqw; text-align: center; display: grid; gap: 1cqw; text-shadow: 0 .2cqw 1.6cqw rgba(0,0,0,.4); }
  .w11-clock strong { font-size: 15cqw; font-weight: 600; letter-spacing: -.5cqw; line-height: 1; order: 1; }
  .w11-clock span { font-size: 3.4cqw; order: 2; }
  .w11-dock { right: 3cqw; bottom: 3cqw; display: flex; gap: 1.4cqw; } .w11-dock i { width: 3.4cqw; height: 3.4cqw; border-radius: 50%; background: rgba(255,255,255,.7); }

  /* macOS */
  .mini-macos { background: #3b2a7a url('/wallpapers/mac-bg.webp') center / cover; }
  .mini-macos::before { content: ''; position: absolute; inset: 0; backdrop-filter: blur(.5cqw); background: rgba(0,0,0,.08); }
  .m-clock { left: 0; right: 0; top: 7cqw; text-align: center; display: grid; line-height: 1; text-shadow: 0 .2cqw 1.4cqw rgba(0,0,0,.3); }
  .m-clock span { font-size: 3.4cqw; font-weight: 600; } .m-clock strong { font-size: 14cqw; font-weight: 700; margin-top: .8cqw; letter-spacing: -.3cqw; }
  .m-user { left: 0; right: 0; bottom: 8cqw; display: grid; justify-items: center; gap: 1.6cqw; }
  .m-av { display: grid; place-items: center; width: 10cqw; height: 10cqw; border-radius: 50%; font-size: 6cqw; background: rgba(255,255,255,.3); border: .3cqw solid rgba(255,255,255,.55); }
  .m-name { font-size: 3cqw; font-weight: 600; }
  .m-pill { width: 22cqw; padding: 1.2cqw 2cqw; border-radius: 99cqw; font-size: 2.2cqw; background: rgba(255,255,255,.28); border: .2cqw solid rgba(255,255,255,.4); text-align: center; }

  @media (prefers-reduced-motion: reduce) { .w7-glow { animation: none; } }
</style>
